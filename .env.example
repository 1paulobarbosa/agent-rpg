# Local watcher HTTP/SSE bind settings (localhost only by default)
AGENT_RPG_HOST=127.0.0.1
AGENT_RPG_PORT=4310

# Persistent save file path (defaults to ~/.agent-rpg/save.json)
AGENT_RPG_SAVE_PATH=

# Directories scanned for live agent logs (optional overrides)
AGENT_RPG_AGY_DIR=
AGENT_RPG_CLAUDE_DIR=

# Set to "true" to start the simulator active on boot (default: false)
AGENT_RPG_SIMULATOR_DEFAULT=false

# Claude Code profile directory. Transcripts are read from $CLAUDE_CONFIG_DIR/projects
# unless AGENT_RPG_CLAUDE_DIR is set.
CLAUDE_CONFIG_DIR=

# Built web client served on the same port (the CLI sets this for you)
AGENT_RPG_STATIC_DIR=
