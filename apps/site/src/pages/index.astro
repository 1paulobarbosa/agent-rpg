---
import CallToAction from '../components/sections/CallToAction.astro'
import Features from '../components/sections/Features.astro'
import Hero from '../components/sections/Hero.astro'
import HowItWorks from '../components/sections/HowItWorks.astro'
import Screenshot from '../components/sections/Screenshot.astro'
import { FEATURES } from '../data/features'
import { BOSSES, BOSSES_TITLE, STEPS } from '../data/steps'
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout>
  <Hero />
  <Screenshot />
  <Features features={FEATURES} />
  <HowItWorks steps={STEPS} bosses={BOSSES} bossesTitle={BOSSES_TITLE} />
  <CallToAction />
</BaseLayout>
